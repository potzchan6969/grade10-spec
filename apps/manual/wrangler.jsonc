{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static publish of the Grade10 Manual to workers.dev on the staging
  // Cloudflare account. The build bakes the store snapshot into dist/api/*,
  // so the site is pure static assets; dist/_headers gives those JSON their
  // content type. SPA fallback keeps /p/... deep links working.
  // URL: https://grade10-manual.<account-subdomain>.workers.dev
  "name": "grade10-manual",
  "compatibility_date": "2026-08-01",
  "account_id": "de021143aac704ccbda9c3cd00be261d",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
