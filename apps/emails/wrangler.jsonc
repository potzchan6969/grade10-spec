{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static publish of the exported email templates (auth + auction letters)
  // to the staging Cloudflare account.
  // URL: https://email.grade10-stg.com
  "name": "grade10-email",
  "compatibility_date": "2026-08-01",
  "account_id": "de021143aac704ccbda9c3cd00be261d",
  "assets": {
    "directory": "./out"
  },
  "routes": [{ "pattern": "email.grade10-stg.com", "custom_domain": true }],
  "workers_dev": false
}
