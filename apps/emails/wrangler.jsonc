{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static publish of the react-email preview app (auth + auction letters)
  // to the staging Cloudflare account. `out/` holds its prerendered pages
  // (see scripts/build-preview.mjs), not a raw `email export` dump.
  // URL: https://email.grade10-stg.com
  "name": "grade10-email",
  "compatibility_date": "2026-08-01",
  "account_id": "de021143aac704ccbda9c3cd00be261d",
  "main": "worker.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // worker.js must see every request first: it serves a route's `.rsc`
    // file for Next's client-side navigation fetch, falling back to the
    // asset the request's path names for everything else.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "email.grade10-stg.com", "custom_domain": true }],
  "workers_dev": false
}
