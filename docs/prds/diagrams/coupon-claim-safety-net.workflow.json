    {
      "from": "attempt",
      "to": "outbox",
      "label": "where the shop would not answer",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "outbox",
      "to": "back",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "guard",
      "to": "back",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "top"
    },
    {
      "from": "sweep",
      "to": "back",
      "label": "and where none of them did",
      "variant": "security",
      "fromSide": "right",
      "toSide": "bottom"
