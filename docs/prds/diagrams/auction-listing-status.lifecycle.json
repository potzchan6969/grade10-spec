    {
      "id": "created",
      "type": "active",
      "label": "Created",
      "sublabel": "ready to sell, not visible",
      "lane": "main",
      "col": 1
    },
    {
      "id": "published",
      "type": "active",
      "label": "Published",
      "sublabel": "on the catalogue",
      "lane": "main",
      "col": 2
    },
    {
      "id": "closed",
      "type": "active",
      "label": "Closed",
      "sublabel": "the close passed",
