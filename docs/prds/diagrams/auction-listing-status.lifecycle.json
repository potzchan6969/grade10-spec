    },
    {
      "id": "schedule",
      "from": "created",
      "to": "scheduled",
      "label": "Publish at set",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left",
      "labelAt": [300, 290]
    },
    {
      "id": "auto-publish",
      "from": "scheduled",
      "to": "published",
      "label": "it arrives",
      "variant": "dashed",
