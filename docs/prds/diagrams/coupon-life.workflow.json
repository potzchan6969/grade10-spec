{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "A coupon's life",
    "animation": "none",
    "visual_preset": "editorial",
    "legend": {
      "mode": "hidden"
    }
  },
  "lanes": [
    {
      "id": "shopify",
      "label": "Shopify"
    },
    {
      "id": "coupon",
      "label": "The coupon"
    }
  ],
  "mainPath": ["redeemed", "available", "claimed", "used"],
  "nodes": [
    {
      "id": "discount",
      "lane": "shopify",
      "col": 2,
      "type": "external",
      "label": "Discount code",
      "sublabel": "a new claim discards the last",
      "tag": "ephemeral",
      "width": 150
    },
    {
      "id": "redeemed",
      "lane": "coupon",
      "col": 0,
      "type": "frontend",
      "label": "Redeemed or granted",
      "sublabel": "points, or an operator",
      "width": 150
    },
    {
      "id": "available",
      "lane": "coupon",
      "col": 1,
      "type": "backend",
      "label": "Available",
      "sublabel": "offered everywhere",
      "width": 150
    },
    {
      "id": "claimed",
      "lane": "coupon",
      "col": 2,
      "type": "cloud",
      "label": "Claimed",
      "sublabel": "a sale intends to use it",
      "tag": "still offered",
      "width": 150
    },
    {
      "id": "used",
      "lane": "coupon",
      "col": 3,
      "type": "database",
      "label": "Used",
      "sublabel": "a paid order spent it",
      "width": 150
    }
  ],
  "edges": [
    {
      "from": "redeemed",
      "to": "available",
      "variant": "emphasis"
    },
    {
      "from": "available",
      "to": "claimed",
      "variant": "emphasis"
    },
    {
      "from": "claimed",
      "to": "used",
      "variant": "emphasis",
      "label": "the order is paid"
    },
    {
      "from": "claimed",
      "to": "discount",
      "fromSide": "top",
      "toSide": "bottom"
    }
  ]
}
