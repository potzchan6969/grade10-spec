  "edges": [
    {
      "from": "listed",
      "to": "listing",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "from": "listing",
      "to": "product",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "product",
      "to": "sold",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "price",
      "to": "listing",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "rule",
      "to": "price",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "right",
      "label": "later"
    },
    {
      "from": "edit",
      "to": "listing",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom",
      "label": "written back"
    }
