{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "The balance's expiry date",
    "animation": "none",
    "visual_preset": "editorial",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [980, 660]
  },
  "lanes": [
    {
      "id": "main",
      "label": "The date"
    },
    {
      "id": "moves",
      "label": "What moves it"
    },
    {
      "id": "terminal",
      "label": "What ends it"
    }
  ],
  "states": [
    {
      "id": "no-date",
      "type": "start",
      "label": "No date",
      "sublabel": "no live point names one",
      "lane": "main",
      "col": 0
    },
    {
      "id": "one-date",
      "type": "success",
      "label": "One date",
      "sublabel": "every live point lapses on it",
      "lane": "main",
      "col": 2
    },
    {
      "id": "activity",
      "type": "active",
      "label": "Buying or redeeming",
      "sublabel": "pushes it twelve months out",
      "lane": "moves",
      "col": 0
    },
    {
      "id": "restart",
      "type": "neutral",
      "label": "Operator restarts it",
      "sublabel": "the window runs again from today",
      "lane": "moves",
      "col": 2
    },
    {
      "id": "lapsed",
      "type": "neutral",
      "label": "Lapsed",
      "sublabel": "written off, never revived",
      "lane": "terminal",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "starts",
      "from": "no-date",
      "to": "one-date",
      "label": "a purchase, or a grant",
      "variant": "emphasis"
    },
    {
      "id": "pushes",
      "from": "activity",
      "to": "one-date",
      "variant": "emphasis"
    },
    {
      "id": "again",
      "from": "restart",
      "to": "one-date",
      "variant": "emphasis"
    },
    {
      "id": "ends",
      "from": "one-date",
      "to": "lapsed",
      "label": "the day arrives",
      "variant": "dashed",
      "route": "left-channel",
      "fromSide": "left",
      "toSide": "left",
      "channelX": 180
    }
  ]
}
