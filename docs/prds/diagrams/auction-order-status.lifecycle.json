{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "An auction order's status",
    "animation": "none",
    "visual_preset": "editorial",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [930, 640]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Order"
    },
    {
      "id": "waiting",
      "label": "In an operator's hands"
    },
    {
      "id": "terminal",
      "label": "Ended"
    }
  ],
  "states": [
    {
      "id": "awaiting-address",
      "type": "start",
      "label": "Awaiting Address",
      "sublabel": "the lot closed",
      "lane": "main",
      "col": 0
    },
    {
      "id": "preparing-invoice",
      "type": "active",
      "label": "Preparing Invoice",
      "sublabel": "address and method confirmed",
      "lane": "main",
      "col": 1
    },
    {
      "id": "pending-payment",
      "type": "waiting",
      "label": "Pending Payment",
      "sublabel": "invoice sent, expired included",
      "lane": "main",
      "col": 2
    },
    {
      "id": "processing",
      "type": "active",
      "label": "Processing",
      "sublabel": "paid, not yet dispatched",
      "lane": "main",
      "col": 3
    },
    {
      "id": "shipped",
      "type": "active",
      "label": "Shipped",
      "sublabel": "carrier and tracking",
      "lane": "main",
      "col": 4
    },
    {
      "id": "payment-verifying",
      "type": "waiting",
      "label": "Payment Verifying",
      "sublabel": "proof uploaded, deadline stopped",
      "lane": "waiting",
      "col": 0
    },
    {
      "id": "partially-paid",
      "type": "waiting",
      "label": "Partially Paid",
      "sublabel": "collected in parts",
      "col": 0,
      "lane": "waiting",
      "yOffset": 76
    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "Cancelled",
      "sublabel": "unpaid; the lot reopens",
      "lane": "terminal",
      "col": 0
    },
    {
      "id": "refunded",
      "type": "neutral",
      "label": "Refunded",
      "sublabel": "one refund, recorded by hand",
      "lane": "terminal",
      "col": 1
    },
    {
      "id": "delivered",
      "type": "success",
      "label": "Delivered",
      "sublabel": "the carrier's proof",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "id": "confirmed",
      "from": "awaiting-address",
      "to": "preparing-invoice",
      "variant": "emphasis"
    },
    {
      "id": "sent",
      "from": "preparing-invoice",
      "to": "pending-payment",
      "variant": "emphasis"
    },
    {
      "id": "paid",
      "from": "pending-payment",
      "to": "processing",
      "variant": "emphasis"
    },
    {
      "id": "dispatched",
      "from": "processing",
      "to": "shipped",
      "variant": "emphasis"
    },
    {
      "id": "proof",
      "from": "pending-payment",
      "to": "payment-verifying",
      "label": "proof uploaded",
      "labelAt": [448, 222]
    },
    {
      "id": "confirmed-proof",
      "from": "payment-verifying",
      "to": "processing",
      "label": "confirmed",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom",
      "labelAt": [520, 294]
    },
    {
      "id": "returned",
      "from": "payment-verifying",
      "to": "pending-payment",
      "label": "not accepted",
      "variant": "dashed",
      "labelAt": [448, 244]
    },
    {
      "id": "cancel",
      "from": "pending-payment",
      "to": "cancelled",
      "label": "an operator cancels",
      "variant": "security",
      "route": "left-channel",
      "fromSide": "left",
      "toSide": "left",
      "channelX": 315,
      "labelAt": [315, 432]
    },
    {
      "id": "refund",
      "from": "processing",
      "to": "refunded",
      "variant": "dashed",
      "route": "right-channel",
      "fromSide": "right",
      "toSide": "right",
      "channelX": 633,
      "label": "a refund is recorded",
      "labelAt": [633, 420]
    },
    {
      "id": "delivery",
      "from": "shipped",
      "to": "delivered",
      "variant": "emphasis"
    },
    {
      "id": "part",
      "from": "pending-payment",
      "to": "partially-paid",
      "label": "part paid",
      "route": "left-channel",
      "fromSide": "left",
      "toSide": "left",
      "channelX": 329,
      "labelAt": [366, 233]
    },
    {
      "id": "closed",
      "from": "partially-paid",
      "to": "processing",
      "label": "paid in full",
      "fromSide": "right",
      "toSide": "bottom",
      "labelAt": [520, 370]
    },
    {
      "id": "refund-part",
      "from": "partially-paid",
      "to": "refunded",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left",
      "via": [[402, 431], [483, 431], [483, 479]]
    },
    {
      "id": "refund-late",
      "from": "delivered",
      "to": "refunded",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel",
      "channelY": 545,
      "label": "even after delivery",
      "labelAt": [637, 545]
    }
  ]
}
