      "lane": "day",
      "col": 0
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "returned; never earns",
      "lane": "terminal",
      "col": 0
    },
    {
      "id": "retrieved",
      "type": "neutral",
      "label": "Retrieved",
      "sublabel": "collected at the shop",
      "lane": "terminal",
      "col": 1
    },
    {
      "id": "sold",
      "type": "success",
      "label": "Sold",
      "sublabel": "stops earning that day",
      "lane": "terminal",
      "col": 2
    }
