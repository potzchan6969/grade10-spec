    },
    {
      "id": "authenticating",
      "type": "decision",
      "label": "Authenticating",
      "sublabel": "here, or checked later",
      "lane": "main",
      "col": 1
    },
    {
      "id": "in-vault",
      "type": "waiting",
      "label": "In the Vault",
      "sublabel": "Vault Terms sealed",
      "lane": "main",
      "col": 2
    },
    {
      "id": "earning",
      "type": "active",
      "label": "Earning",
      "sublabel": "from Earning Starts",
      "lane": "main",
      "col": 3
    },
    {
      "id": "consigned",
      "type": "active",
      "label": "Consigned",
      "sublabel": "on sale, still earning",
      "lane": "main",
      "col": 4
    },
    {
      "id": "not-eligible",
      "type": "neutral",
      "label": "Not Eligible",
