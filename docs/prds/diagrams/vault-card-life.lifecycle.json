    },
    {
      "id": "sealed",
      "from": "authenticating",
      "to": "in-vault",
      "variant": "emphasis"
    },
    {
      "id": "starts",
      "from": "in-vault",
      "to": "earning",
      "variant": "emphasis"
    },
    {
      "id": "consign",
      "from": "earning",
      "to": "consigned",
      "variant": "emphasis"
    },
    {
