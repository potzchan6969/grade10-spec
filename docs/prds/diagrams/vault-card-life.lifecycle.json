    {
      "id": "sell",
      "from": "consigned",
      "to": "sold",
      "variant": "emphasis",
      "label": "sold",
      "labelAt": [710, 240]
    },
    {
      "id": "ended",
      "from": "consigned",
      "to": "earning",
      "variant": "dashed",
      "route": "top-channel",
      "fromSide": "top",
      "toSide": "top",
      "label": "ended, unsold or rejected"
