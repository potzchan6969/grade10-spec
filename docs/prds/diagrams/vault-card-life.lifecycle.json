{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "A card in the vault",
    "animation": "none",
    "visual_preset": "editorial",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [980, 760]
  },
  "lanes": [
    {
      "id": "main",
      "label": "In the vault"
    },
    {
      "id": "day",
      "label": "Some days"
    },
    {
      "id": "terminal",
      "label": "Leaves the vault"
    }
  ],
  "states": [
    {
      "id": "received",
