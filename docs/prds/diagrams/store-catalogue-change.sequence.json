{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "A change reaches the listing",
    "animation": "none",
    "visual_preset": "editorial",
    "column_fit": "spread",
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [720, 700]
  },
  "participants": [
    {
      "id": "shop",
      "type": "external",
      "label": "Shop",
      "sublabel": "the shopkeeper saves"
    },
    {
      "id": "shopify",
      "type": "external",
      "label": "Shopify",
      "sublabel": "events and reads"
    },
    {
      "id": "store",
      "type": "backend",
      "label": "Store",
      "sublabel": "at every location"
    },
    {
      "id": "copy",
      "type": "backend",
      "label": "The copy",
      "sublabel": "one per shop"
    },
    {
      "id": "collector",
      "type": "external",
      "label": "Collector",
      "sublabel": "anywhere"
    }
  ],
  "segments": [
    {
      "from": 170,
      "to": 400,
      "label": "Seconds after save"
    },
    {
      "from": 430,
      "to": 590,
      "label": "The next listing view, at any location"
    }
  ],
  "messages": [
    {
      "id": "saves",
      "from": "shop",
      "to": "shopify",
      "y": 200,
      "label": "saves a product, or stock moves",
      "variant": "default"
    },
    {
      "id": "reports-a-change",
      "from": "shopify",
      "to": "store",
      "y": 240,
      "label": "the product's event, signed",
      "variant": "emphasis"
    },
    {
      "id": "takes-the-report",
      "from": "store",
      "to": "copy",
      "y": 280,
      "label": "the report",
      "variant": "emphasis"
    },
    {
      "id": "accepted",
      "from": "store",
      "to": "shopify",
      "y": 310,
      "label": "accepted",
      "variant": "return"
    },
    {
      "id": "reads-the-product-back",
      "from": "copy",
      "to": "shopify",
      "y": 345,
      "label": "reads the product back, again every 2 s while it answers the old value",
      "variant": "dashed"
    },
    {
      "id": "publishes-a-new-copy",
      "from": "shopify",
      "to": "copy",
      "y": 380,
      "label": "the product as the shop shows it \u00b7 a new copy, numbered",
      "variant": "return"
    },
    {
      "id": "opens",
      "from": "collector",
      "to": "store",
      "y": 460,
      "label": "opens the listing",
      "variant": "default"
    },
    {
      "id": "every-location-follows",
      "from": "store",
      "to": "copy",
      "y": 495,
      "label": "copy number, and the copy if it moved \u00b7 every 3 s",
      "variant": "dashed"
    },
    {
      "id": "copy",
      "from": "copy",
      "to": "store",
      "y": 530,
      "label": "the current copy",
      "variant": "return"
    },
    {
      "id": "answer",
      "from": "store",
      "to": "collector",
      "y": 565,
      "label": "the listing, as the shop is now",
      "variant": "emphasis"
    }
  ],
