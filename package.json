{
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "agent:sync-parity": "bash scripts/agent-platform/sync-parity.sh",
    "agent:check-parity": "bash scripts/agent-platform/check-parity.sh",
    "build:components": "pnpm --filter @acetrader/pred-spec-ui run build",
    "cache:prime": "pnpm install --frozen-lockfile --prefer-offline",
    "check:components": "pnpm --filter @acetrader/pred-spec-ui run check:stateless",
    "check:design-system": "pnpm --filter @acetrader/design-system run components:check",
    "setup:browsers": "pnpm --dir apps/ui exec playwright install chromium",
    "setup:worktree": "pnpm install --frozen-lockfile --prefer-offline",
    "storybook": "node scripts/storybook.mjs",
    "storybook:design-system": "node scripts/storybook.mjs --dir packages/design-system",
    "test:stories": "pnpm run test:stories:ui && pnpm run test:stories:design-system",
    "test:stories:ui": "pnpm --dir apps/ui exec vitest run",
    "test:stories:design-system": "pnpm --filter @acetrader/design-system run test:stories",
    "tokens:build": "pnpm --filter @acetrader/design-system run tokens:build",
    "tokens:sync": "pnpm --filter @acetrader/design-system run tokens:sync",
    "typecheck": "pnpm --dir apps/ui exec tsc -b && pnpm --filter @acetrader/pred-spec-ui exec tsc --project tsconfig.json --noEmit && pnpm --filter @acetrader/design-system run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  }
}
