{
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "agent:sync-parity": "bash scripts/agent-platform/sync-parity.sh",
    "agent:check-parity": "bash scripts/agent-platform/check-parity.sh",
    "cache:prime": "pnpm install --frozen-lockfile --prefer-offline",
    "design-sync:check": "node scripts/design-sync/check-components.mjs",
    "design-sync:audit": "node scripts/design-sync/audit-node.mjs",
    "figma:annotations:inventory": "node scripts/design-sync/annotation-inventory-cli.mjs",
    "figma:annotations:diff": "node scripts/design-sync/annotation-diff.mjs",
    "figma:annotations:report": "node scripts/design-sync/annotation-report-cli.mjs",
    "figma:annotations:accept": "node scripts/design-sync/annotation-accept.mjs",
    "code-connect:publish:design-system": "pnpm --filter @grade10/design-system run code-connect:publish",
    "code-connect:publish:ui": "pnpm --filter @grade10/ui run code-connect:publish",
    "setup:browsers": "pnpm --dir apps/preview exec playwright install chromium",
    "setup:worktree": "pnpm install --frozen-lockfile --prefer-offline",
    "test": "pnpm -r --if-present run test && pnpm run test:design-sync",
    "test:design-sync": "node --test scripts/design-sync/*.test.mjs",
    "storybook": "node scripts/storybook/storybook.mjs",
    "storybook:workbench": "node scripts/storybook/storybook.mjs --dir apps/preview --config-dir .storybook-workbench",
    "storybook:design-system": "node scripts/storybook/storybook.mjs --dir packages/design-system",
    "storybook:ui": "node scripts/storybook/storybook.mjs --dir packages/ui",
    "storybook:build:design-system": "pnpm --filter @grade10/design-system run build-storybook",
    "storybook:build:workbench": "pnpm --dir apps/preview run build-storybook:workbench",
    "storybook:changed-pages": "node scripts/storybook/changed-page-links.mjs",
    "storybook:deploy:staging": "pnpm --dir apps/preview run deploy-storybook:staging",
    "test:stories": "pnpm run test:stories:design-system && pnpm run test:stories:ui && pnpm run test:stories:app",
    "test:stories:design-system": "pnpm --filter @grade10/design-system run test:stories",
    "test:stories:ui": "pnpm --filter @grade10/ui run test:stories",
    "test:stories:app": "pnpm --dir apps/preview exec vitest run",
    "tokens:import": "node scripts/tokens-sync/figma-plugins/pull.mjs",
    "tokens:build": "node scripts/tokens-sync/build-css.mjs",
    "tokens:push": "node scripts/tokens-sync/figma-plugins/push.mjs",
    "tokens:plugin": "node scripts/tokens-sync/figma-plugins/build-plugin.mjs",
    "tokens:pull": "pnpm tokens:import && pnpm tokens:build",
    "typecheck": "pnpm --dir apps/preview exec tsc -b && pnpm --filter @grade10/design-system run typecheck && pnpm --filter @grade10/i18n run typecheck && pnpm --filter @grade10/ui run typecheck",
    "lint": "biome check .",
    "plan:preflight": "node scripts/openspec/plan-preflight.mjs",
    "spec:view": "bash scripts/openspec-viewer/spec-view.sh",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "typescript": "~6.0.2"
  }
}
