    "GW2WL6JcWok5ypUrUFi9bU:4647:3226": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4647:3226",
      "sourceRoot": "4098:2423",
      "annotations": [
        {
          "annotationKey": "accepted:974e63f0070d459f:1",
          "text": "**Link target (TBC):**\n1. Shipping fee: Shipping fee details webpage\n2. Hong Kong Grade10 Store: Store locator webpage or open in Google Maps",
          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4647:3264": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4647:3264",
      "sourceRoot": "4098:2423",
      "annotations": [
        {
          "annotationKey": "accepted:a8a1bf55ea1485d6:1",
          "text": "**After adding to cart (ATC):**\n1. Disable stepper input.\n2. Change Add to cart button to loading state “Adding...”.\n3. Show the mini-cart overlay\n4. Reset the stepper input.\n5. Change Add button label to “Added to cart” if the product is in the cart.\n\n**Sold Out**\nIf the product is sold out (inventory qty = 0),\n1. Disable the stepper input.\n2. Change Add button to a disabled “Sold out” button without a leading icon.",
          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4647:3265": {
