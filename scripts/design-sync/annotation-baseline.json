          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4288:14092": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4288:14092",
      "sourceRoot": "4288:14117",
      "annotations": [
        {
          "annotationKey": "accepted:45fa2927b32801c7:1",
          "text": "Result count\n\nIf only 1 product, shows “1 Product”.\nIf no product, shows the empty state component.",
          "categoryId": "86:3",
          "pinnedProperties": [],
          "associations": {
            "capability": "shared-ui/store-product-listing"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4357:527": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4357:527",
      "sourceRoot": "4357:527",
      "annotations": [
        {
          "annotationKey": "accepted:7f35190b001ccd0f:1",
          "text": "By default, displays all worlds and types (no checkbox are checked visually).\n\nClicking any checkbox to filter results. Results will be reloaded.\n\nSee all worlds:\nExpand the other checkboxes for worlds.\n\nSorting:\n1. Worlds: total number of products from the most to the least\n2. Types: Booster Box > Special Box > Graded Card > total no. of products from the most to the least.",
          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "shared-ui/store-product-listing"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4447:6009": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4447:6009",
      "sourceRoot": "4098:2423",
      "annotations": [
        {
          "annotationKey": "accepted:f657f3efe08bd2e3:1",
          "text": "Scroll the whole page vertically to view the image(s).\n1. No zoom / lightbox — images are displayed at full size.\n2. Min. 1, max. 5 images per product.\n3. If the product has no image (edge case), show a placeholder image.",
          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4647:3188": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4647:3188",
      "sourceRoot": "4098:2423",
      "annotations": [
        {
          "annotationKey": "accepted:15984e0d6f39e195:1",
          "text": "**SKU**: Display-only, not interactive. For customer reference when contacting support.",
          "categoryId": "86:3",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
