    "GW2WL6JcWok5ypUrUFi9bU:4098:2515": {
      "fileKey": "GW2WL6JcWok5ypUrUFi9bU",
      "nodeId": "4098:2515",
      "sourceRoot": "4098:2423",
      "annotations": [
        {
          "annotationKey": "accepted:a27dbcaeae1ddc29:1",
          "text": "**Floating price for non-graded products**\nSome products may be in floating pricing. Show Boneyard skeleton when fetching and updating the price.\n\n**Compare-at (strike-through) price:**\n1. Shown when the product is discounted (sale flag from Shopify CMS).\n2. Same logic as the `Product Card` component.",
          "categoryId": "86:1",
          "pinnedProperties": [],
          "associations": {
            "capability": "grade10-store/product-page"
          }
        }
      ]
    },
    "GW2WL6JcWok5ypUrUFi9bU:4266:8638": {
