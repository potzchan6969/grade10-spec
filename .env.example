# Local secrets for the design-system Figma legs. Copy to `.env` at the
# repository root and fill in. `.env` is gitignored; never commit a token.
#
# CI passes these as real environment variables, so this file is for humans.

# Reads the Figma file to diff every component set against its cva and its
# Code Connect template.
#   pnpm run design-sync:check
# Scope: files:read. Loaded from this file by scripts/check-components.mjs.
FIGMA_TOKEN=figd_

# Publishes Code Connect templates. A different variable and a different
# scope set to the one above — a files:read token parses fine and then fails
# at the write.
#   FIGMA_ACCESS_TOKEN=figd_… pnpm --filter @grade10/design-system run code-connect:publish
# Scopes: File content: read, plus Code Connect: write.
FIGMA_ACCESS_TOKEN=figd_
