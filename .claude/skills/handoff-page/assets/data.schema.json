{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-page/data.schema.json",
  "title": "Handoff page data",
  "description": "The facts one handoff, decision or digest page is drawn from. scripts/build.mjs reads its key lists and allowed values from this file, and checks the rules a schema cannot say: one recommended option first, proof rows naming real changes, files beside the data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "reason", "stamp"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Where an editor finds this file; the page ignores it."
    },
    "example": {
      "type": "boolean",
      "description": "Marks the example data; delete it once every value is your own."
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "The page's name, two to four words: Extended Bidding Label."
    },
    "page": {
      "enum": ["feature", "decision", "digest"],
      "default": "feature",
      "description": "feature hands finished or blocked work; decision asks for choices; digest is what /checkpoint-digest posts."
    },
    "lead": {
      "enum": ["changes", "extra"],
      "description": "changes keeps What changed first when Decide would lead; extra opens on the extra section."
    },
    "verdict": {
      "enum": ["ready", "decide", "not-ready", "blocked"],
      "description": "Where the work stands. A digest has none."
    },
    "reason": {
      "$ref": "#/$defs/words",
      "description": "The one reason, as the page's headline, in one line: Ready to merge once 2 decisions are made."
    },
    "stamp": { "$ref": "#/$defs/stamp" },
    "numbers": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/number" },
      "description": "Up to four counts the reader would quote, drawn large under the headline."
    },
    "since": {
      "$ref": "#/$defs/words",
      "description": "From v2: what moved since the last version. On a digest: what the reader must know first, such as a rewritten branch."
    },
    "decide": { "$ref": "#/$defs/decide" },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" },
      "description": "What a person notices, one card each. A feature or digest page always has one."
    },
    "try": { "$ref": "#/$defs/try" },
    "proof": {
      "type": "array",
      "items": { "$ref": "#/$defs/proof" },
      "description": "Every claim, how it was proven and on which commit. A digest leaves it out."
    },
    "ship": { "$ref": "#/$defs/ship" },
    "followups": {
      "type": "array",
      "items": { "$ref": "#/$defs/followup" }
    },
    "engineers": { "$ref": "#/$defs/engineers" },
    "extra": { "$ref": "#/$defs/extra" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "page": { "const": "digest" } },
        "required": ["page"]
      },
      "then": {
        "not": { "required": ["verdict"] },
        "properties": { "stamp": { "required": ["from", "fromDate"] } }
      },
      "else": {
        "required": ["verdict", "proof"],
        "properties": { "stamp": { "required": ["version"] } }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "words": {
      "type": "string",
      "minLength": 1,
      "description": "Plain text in the reader's words, with plain hyphens and no dashes; **bold**, `code` and [text](https://...) render."
    },
    "href": {
      "type": "string",
      "pattern": "^https?://",
      "description": "A full link, starting https://."
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}",
      "description": "A day as YYYY-MM-DD: 2026-10-19."
    },
    "tone": { "enum": ["ok", "warn", "bad", "info", "accent", "none"] },
    "who": {
      "description": "The readers who notice it: [\"Bidders\", \"Design\"].",
      "anyOf": [
        { "$ref": "#/$defs/text" },
        { "type": "array", "items": { "$ref": "#/$defs/text" } }
      ]
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "description": "Where and when the page was read; a page tied to no commit cannot be trusted after the next push.",
      "properties": {
        "repo": {
          "$ref": "#/$defs/text",
          "description": "owner/name: 9gag/grade10."
        },
        "branch": { "$ref": "#/$defs/text" },
        "from": {
          "$ref": "#/$defs/text",
          "description": "A digest's checkpoint commit, 7 characters."
        },
        "fromDate": {
          "$ref": "#/$defs/day",
          "description": "The day the checkpoint commit landed: fromDate in facts.json."
        },
        "commit": {
          "$ref": "#/$defs/text",
          "description": "7 characters; a merged change stamps its merge commit."
        },
        "date": { "$ref": "#/$defs/day" },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$",
          "description": "v1 on the first publish, then v2 and on."
        }
      }
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {
          "$ref": "#/$defs/words",
          "description": "What is counted: commits."
        },
        "value": {
          "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/text" }],
          "description": "The count, or short text."
        }
      }
    },
    "decide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/question" }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
        "agentDecisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentDecision" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "title", "ask", "options", "why", "blocks"],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "description": "1, 2, 3; never renumber a published one."
        },
        "title": { "$ref": "#/$defs/words" },
        "ask": {
          "$ref": "#/$defs/words",
          "description": "The exact question."
        },
        "picture": { "$ref": "#/$defs/picture" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" },
          "description": "The recommended option first, as A."
        },
        "why": { "$ref": "#/$defs/words" },
        "blocks": { "$ref": "#/$defs/words" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } },
        "answered": { "$ref": "#/$defs/answered" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "outcome", "cost"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z]$" },
        "label": { "$ref": "#/$defs/words" },
        "recommended": { "type": "boolean" },
        "outcome": { "$ref": "#/$defs/words" },
        "cost": {
          "$ref": "#/$defs/words",
          "description": "None when nothing."
        },
        "picture": { "$ref": "#/$defs/picture" }
      }
    },
    "answered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "text"],
      "properties": {
        "option": { "type": "string", "pattern": "^[A-Z]$" },
        "text": {
          "$ref": "#/$defs/words",
          "description": "The record that now holds the answer, such as a decisions.md row."
        },
        "href": { "$ref": "#/$defs/href" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "title", "action", "why", "blocks"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/words" },
        "action": {
          "$ref": "#/$defs/words",
          "description": "The exact action a person takes."
        },
        "who": { "$ref": "#/$defs/words" },
        "why": { "$ref": "#/$defs/words" },
        "blocks": { "$ref": "#/$defs/words" },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason" } },
        "done": { "$ref": "#/$defs/done" }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/words" },
        "href": { "$ref": "#/$defs/href" }
      }
    },
    "agentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "taken"],
      "properties": {
        "decision": { "$ref": "#/$defs/words" },
        "taken": { "$ref": "#/$defs/words" },
        "why": { "$ref": "#/$defs/words" }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/words" },
        "href": { "$ref": "#/$defs/href" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "href"],
      "properties": {
        "text": { "$ref": "#/$defs/words" },
        "href": { "$ref": "#/$defs/href" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "now"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The card's address; never one the page uses, such as decide or proof."
        },
        "kind": {
          "enum": ["new", "changed", "removed", "settled"],
          "description": "settled only on a decision page; a digest's overview card leaves it out."
        },
        "phase": {
          "$ref": "#/$defs/text",
          "description": "The area or stage it groups under."
        },
        "who": { "$ref": "#/$defs/who" },
        "title": { "$ref": "#/$defs/words" },
        "before": {
          "$ref": "#/$defs/words",
          "description": "Needed by changed and removed."
        },
        "now": { "$ref": "#/$defs/words" },
        "picture": { "$ref": "#/$defs/picture" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" },
          "description": "The sources a reader opens next: the proposal, the pull request, the requirement."
        },
        "commits": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "description": "Digest only: the commits it comes from, from facts.json; the Slack post lists a change only when one of them is new since the last post."
        }
      }
    },
    "try": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "where": { "$ref": "#/$defs/words" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "role": { "$ref": "#/$defs/text" },
        "when": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/words" },
        "where": { "$ref": "#/$defs/words" },
        "do": { "$ref": "#/$defs/words" },
        "success": { "$ref": "#/$defs/words" },
        "picture": { "$ref": "#/$defs/picture" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "how", "status"],
      "properties": {
        "claim": { "$ref": "#/$defs/words" },
        "how": { "$ref": "#/$defs/words" },
        "revision": { "$ref": "#/$defs/text" },
        "href": { "$ref": "#/$defs/href" },
        "status": { "enum": ["verified", "partial", "not-run", "failed"] },
        "why": { "$ref": "#/$defs/words" },
        "change": {
          "$ref": "#/$defs/text",
          "description": "The id of the change it proves."
        }
      }
    },
    "ship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs": { "type": "array", "items": { "$ref": "#/$defs/words" } },
        "risk": { "$ref": "#/$defs/words" },
        "undo": { "$ref": "#/$defs/words" }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "$ref": "#/$defs/words" },
        "why": { "$ref": "#/$defs/words" },
        "owner": { "$ref": "#/$defs/words" },
        "due": { "$ref": "#/$defs/words" }
      }
    },
    "engineers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commits": { "type": "array", "items": { "$ref": "#/$defs/commit" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/words" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "subject"],
      "properties": {
        "sha": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "#/$defs/text" },
        "href": { "$ref": "#/$defs/href" }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "file"],
      "properties": {
        "title": { "$ref": "#/$defs/words" },
        "file": {
          "$ref": "#/$defs/text",
          "description": "An HTML fragment beside the data file."
        }
      }
    },
    "picture": {
      "description": "One picture, or a list of them.",
      "anyOf": [
        { "$ref": "#/$defs/onePicture" },
        { "type": "array", "items": { "$ref": "#/$defs/onePicture" } }
      ]
    },
    "onePicture": {
      "oneOf": [
        { "$ref": "#/$defs/picture-shot" },
        { "$ref": "#/$defs/picture-beforeNow" },
        { "$ref": "#/$defs/picture-mock" },
        { "$ref": "#/$defs/picture-flow" },
        { "$ref": "#/$defs/picture-lanes" },
        { "$ref": "#/$defs/picture-states" },
        { "$ref": "#/$defs/picture-table" },
        { "$ref": "#/$defs/picture-bars" },
        { "$ref": "#/$defs/picture-diff" },
        { "$ref": "#/$defs/picture-board" }
      ]
    },
    "caption": { "$ref": "#/$defs/words" },
    "rendered": {
      "$ref": "#/$defs/text",
      "description": "The commit whose screen a mock stands in for."
    },
    "added": { "type": "boolean", "description": "An option adds all of it." },
    "picture-shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "src"],
      "description": "A screen of the build under review.",
      "properties": {
        "kind": { "const": "shot" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "src": {
          "$ref": "#/$defs/text",
          "description": "A path beside the data: shots/lot.jpg."
        },
        "phone": { "type": "boolean" }
      }
    },
    "picture-beforeNow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "before", "now"],
      "description": "Two shots of the same state.",
      "properties": {
        "kind": { "const": "beforeNow" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "before": { "$ref": "#/$defs/text" },
        "now": { "$ref": "#/$defs/text" }
      }
    },
    "picture-mock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "What a person sees where no build shows it yet, in the product's own colours.",
      "properties": {
        "kind": { "const": "mock" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "draft": { "type": "boolean" },
        "frame": { "enum": ["phone", "desktop", "email", "push"] },
        "title": { "$ref": "#/$defs/words" },
        "url": {
          "$ref": "#/$defs/text",
          "description": "The desktop frame's address."
        },
        "from": { "$ref": "#/$defs/words" },
        "subject": { "$ref": "#/$defs/words" },
        "app": { "$ref": "#/$defs/words" },
        "time": { "$ref": "#/$defs/words" },
        "body": { "$ref": "#/$defs/words" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/mockItem" } }
      }
    },
    "mockItem": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "One part of the screen: exactly one of h, text, label, button, switch, field, notice, tip, badge or divider.",
      "properties": {
        "h": { "$ref": "#/$defs/words" },
        "text": { "$ref": "#/$defs/words" },
        "label": { "$ref": "#/$defs/words" },
        "button": { "$ref": "#/$defs/words" },
        "switch": { "$ref": "#/$defs/words" },
        "field": { "$ref": "#/$defs/words" },
        "notice": { "$ref": "#/$defs/words" },
        "tip": { "$ref": "#/$defs/words" },
        "badge": { "$ref": "#/$defs/words" },
        "divider": { "type": "boolean" },
        "value": { "$ref": "#/$defs/words" },
        "muted": { "type": "boolean" },
        "primary": { "type": "boolean" },
        "on": { "type": "boolean" },
        "tone": { "$ref": "#/$defs/tone" },
        "draft": { "type": "boolean" },
        "added": { "type": "boolean" }
      }
    },
    "picture-flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "description": "A path through screens or systems.",
      "properties": {
        "kind": { "const": "flow" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/flowStep" }
        }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/words" },
        "who": { "$ref": "#/$defs/words" },
        "tone": { "$ref": "#/$defs/tone" },
        "arrow": {
          "$ref": "#/$defs/words",
          "description": "The label on the way in."
        }
      }
    },
    "picture-lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lanes", "events"],
      "description": "Two people racing, or anything with a clock.",
      "properties": {
        "kind": { "const": "lanes" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/text" }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lanesEvent" }
        }
      }
    },
    "lanesEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "text"],
      "properties": {
        "at": { "$ref": "#/$defs/text" },
        "lane": { "$ref": "#/$defs/text", "description": "One of the lanes." },
        "to": { "$ref": "#/$defs/text", "description": "One of the lanes." },
        "text": { "$ref": "#/$defs/words" },
        "tone": { "$ref": "#/$defs/tone" }
      }
    },
    "picture-states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "states"],
      "description": "A status and what moves it.",
      "properties": {
        "kind": { "const": "states" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "means"],
      "properties": {
        "name": { "$ref": "#/$defs/words" },
        "means": { "$ref": "#/$defs/words" },
        "by": { "$ref": "#/$defs/words" },
        "who": { "$ref": "#/$defs/words" }
      }
    },
    "picture-table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rows"],
      "description": "What moved, in rows and columns.",
      "properties": {
        "kind": { "const": "table" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": { "type": ["string", "number"] }
          }
        }
      }
    },
    "picture-bars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "description": "Numbers compared.",
      "properties": {
        "kind": { "const": "bars" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "unit": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/bar" }
        }
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/words" },
        "value": { "type": "number" }
      }
    },
    "picture-diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rows"],
      "description": "Words or values that changed, key by key; a colour shows its swatch.",
      "properties": {
        "kind": { "const": "diff" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diffRow" }
        }
      }
    },
    "diffRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "anyOf": [{ "required": ["before"] }, { "required": ["now"] }],
      "description": "Only now draws it as new; only before draws it as removed.",
      "properties": {
        "name": {
          "$ref": "#/$defs/words",
          "description": "The token, key or rule that moved."
        },
        "before": { "type": "string" },
        "now": { "type": "string" }
      }
    },
    "picture-board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "columns"],
      "description": "Things moving between stages.",
      "properties": {
        "kind": { "const": "board" },
        "caption": { "$ref": "#/$defs/caption" },
        "rendered": { "$ref": "#/$defs/rendered" },
        "added": { "$ref": "#/$defs/added" },
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/boardColumn" }
        }
      }
    },
    "boardColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": {
        "name": {
          "$ref": "#/$defs/words",
          "description": "The stage: Proposed."
        },
        "tone": { "$ref": "#/$defs/tone" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/words" } }
      }
    }
  }
}
