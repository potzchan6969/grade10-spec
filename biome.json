{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!packages/design-system/src/theme.css",
      "!packages/design-system/src/themes/grade10.css",
      "!tools/openspec-viewer",
      "!tools/manual/public/fixture-snapshot.json",
      "!scripts/diagrams/vendor/archify",
      "!openspec/changes/**/mock.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/blocks/**", "!**/*.stories.tsx"],
      "plugins": [
        "./scripts/biome-plugins/use-layout-primitives.grit",
        "./scripts/biome-plugins/use-token-values.grit"
      ]
    },
    {
      "includes": ["scripts/tokens-sync/**", "scripts/design-sync/**"],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
