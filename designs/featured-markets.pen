{
  "version": "2.14",
  "variables": {
    "color.background": { "type": "color", "value": "#0B1120" },
    "color.layer": { "type": "color", "value": "#121A2A" },
    "color.border": { "type": "color", "value": "#263248" },
    "color.text": { "type": "color", "value": "#F8FAFC" },
    "color.secondary": { "type": "color", "value": "#94A3B8" },
    "color.muted": { "type": "color", "value": "#64748B" },
    "color.brand": { "type": "color", "value": "#A78BFA" },
    "color.brandSoft": { "type": "color", "value": "#2E2548" },
    "color.success": { "type": "color", "value": "#4ADE80" },
    "color.successSoft": { "type": "color", "value": "#173B2A" },
    "color.error": { "type": "color", "value": "#FB7185" },
    "radius.medium": { "type": "number", "value": 10 }
  },
  "children": [
    {
      "id": "desktop-specimen",
      "name": "Desktop — BTC 15 min chart",
      "type": "frame",
      "x": 0,
      "y": 0,
      "width": 1200,
      "height": 640,
      "fill": "$color.background",
      "cornerRadius": "$radius.medium",
      "clip": true,
      "children": [
        {
          "id": "desktop-panel",
          "name": "FeaturedMarkets desktop panel",
          "type": "frame",
          "x": 24,
          "y": 56,
          "width": 1152,
          "height": 560,
          "fill": "$color.layer",
          "stroke": "$color.border",
          "strokeWidth": 1,
          "cornerRadius": "$radius.medium",
          "clip": true,
          "children": [
            {
              "id": "sidebar",
              "name": "Featured markets navigation",
              "type": "frame",
              "x": 0,
              "y": 0,
              "width": 348,
              "height": 560,
              "fill": "$color.layer",
              "stroke": "$color.border",
              "strokeWidth": { "right": 1 },
              "children": [
                { "id": "crypto-label", "type": "text", "x": 16, "y": 20, "content": "CRYPTO UP OR DOWN", "fill": "$color.secondary", "fontSize": 12, "fontWeight": "700", "letterSpacing": 0.6 },
                { "id": "duration-selected", "type": "frame", "x": 16, "y": 48, "width": 316, "height": 38, "fill": "$color.brandSoft", "cornerRadius": 8, "children": [{ "id": "duration-selected-label", "type": "text", "x": 12, "y": 10, "content": "15 min Crypto", "fill": "$color.text", "fontSize": 14, "fontWeight": "600" }] },
                { "id": "duration-hour", "type": "frame", "x": 16, "y": 94, "width": 316, "height": 38, "fill": "#121A2A", "cornerRadius": 8, "children": [{ "id": "duration-hour-label", "type": "text", "x": 12, "y": 10, "content": "1 hr Crypto", "fill": "$color.secondary", "fontSize": 14, "fontWeight": "600" }] },
                { "id": "trending-label", "type": "text", "x": 16, "y": 172, "content": "TRENDING", "fill": "$color.secondary", "fontSize": 12, "fontWeight": "700", "letterSpacing": 0.6 },
                { "id": "trending-bitcoin", "type": "frame", "x": 16, "y": 200, "width": 316, "height": 48, "fill": "#121A2A", "cornerRadius": 8, "children": [{ "id": "trending-bitcoin-label", "type": "text", "x": 12, "y": 10, "width": 280, "textGrowth": "fixed-width", "content": "Will Bitcoin exceed $150K?", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" }] },
                { "id": "trending-rates", "type": "frame", "x": 16, "y": 256, "width": 316, "height": 48, "fill": "#121A2A", "cornerRadius": 8, "children": [{ "id": "trending-rates-label", "type": "text", "x": 12, "y": 10, "width": 280, "textGrowth": "fixed-width", "content": "Will rates be cut next month?", "fill": "$color.secondary", "fontSize": 14, "fontWeight": "500" }] }
              ]
            },
            {
              "id": "desktop-content",
              "type": "frame",
              "x": 348,
              "y": 0,
              "width": 804,
              "height": 560,
              "fill": "$color.layer",
              "children": [
                {
                  "id": "asset-tabs",
                  "name": "Assets",
                  "type": "frame",
                  "x": 16,
                  "y": 0,
                  "width": 772,
                  "height": 48,
                  "fill": "$color.layer",
                  "stroke": "$color.border",
                  "strokeWidth": { "bottom": 1 },
                  "children": [
                    { "id": "btc-tab", "type": "frame", "x": 4, "y": 0, "width": 132, "height": 48, "fill": "$color.layer", "stroke": "$color.success", "strokeWidth": { "bottom": 2 }, "children": [{ "id": "btc-tab-text", "type": "text", "x": 8, "y": 15, "content": "BTC   61% Up", "fill": "$color.success", "fontSize": 14, "fontWeight": "600" }] },
                    { "id": "eth-tab", "type": "text", "x": 156, "y": 15, "content": "ETH   54% Down", "fill": "$color.secondary", "fontSize": 14, "fontWeight": "600" },
                    { "id": "sol-tab", "type": "text", "x": 328, "y": 15, "content": "SOL   58% Up", "fill": "$color.secondary", "fontSize": 14, "fontWeight": "600" }
                  ]
                },
                {
                  "id": "chart-card",
                  "name": "Featured market chart card",
                  "type": "frame",
                  "x": 16,
                  "y": 64,
                  "width": 772,
                  "height": 480,
                  "fill": "$color.layer",
                  "stroke": "$color.border",
                  "strokeWidth": 1,
                  "cornerRadius": "$radius.medium",
                  "children": [
                    { "id": "btc-avatar", "type": "frame", "x": 16, "y": 16, "width": 48, "height": 48, "fill": "#1E293B", "cornerRadius": 8, "children": [{ "id": "btc-avatar-text", "type": "text", "x": 9, "y": 15, "content": "BTC", "fill": "$color.text", "fontSize": 13, "fontWeight": "700" }] },
                    { "id": "market-title", "type": "text", "x": 76, "y": 16, "content": "BTC 15 Minute Up or Down", "fill": "$color.text", "fontSize": 18, "fontWeight": "500" },
                    { "id": "market-status", "type": "text", "x": 76, "y": 40, "content": "Ends in 08:42", "fill": "$color.secondary", "fontSize": 14 },
                    { "id": "market-period", "type": "text", "x": 76, "y": 59, "content": "12:00–12:15 UTC", "fill": "$color.muted", "fontSize": 12 },
                    { "id": "market-external", "type": "text", "x": 732, "y": 26, "content": "↗", "fill": "$color.secondary", "fontSize": 20, "fontWeight": "600" },
                    { "id": "stat-divider-1", "type": "rectangle", "x": 240, "y": 96, "width": 1, "height": 44, "fill": "$color.border" },
                    { "id": "stat-divider-2", "type": "rectangle", "x": 484, "y": 96, "width": 1, "height": 44, "fill": "$color.border" },
                    { "id": "stat-price-beat", "type": "text", "x": 16, "y": 96, "content": "$104,200", "fill": "$color.text", "fontSize": 16, "fontWeight": "500" },
                    { "id": "stat-price-beat-label", "type": "text", "x": 16, "y": 119, "content": "Price to Beat", "fill": "$color.secondary", "fontSize": 12 },
                    { "id": "stat-current", "type": "text", "x": 258, "y": 96, "content": "$104,840", "fill": "$color.success", "fontSize": 16, "fontWeight": "500" },
                    { "id": "stat-current-label", "type": "text", "x": 258, "y": 119, "content": "Current Price", "fill": "$color.secondary", "fontSize": 12 },
                    { "id": "stat-volume", "type": "text", "x": 502, "y": 96, "content": "$1.2M", "fill": "$color.text", "fontSize": 16, "fontWeight": "500" },
                    { "id": "stat-volume-label", "type": "text", "x": 502, "y": 119, "content": "Volume", "fill": "$color.secondary", "fontSize": 12 },
                    { "id": "source-tabs", "type": "frame", "x": 16, "y": 156, "width": 156, "height": 40, "fill": "#0B1120", "cornerRadius": 12, "children": [{ "id": "source-pm", "type": "frame", "x": 4, "y": 4, "width": 70, "height": 32, "fill": "$color.brandSoft", "cornerRadius": 8, "children": [{ "id": "source-pm-text", "type": "text", "x": 23, "y": 9, "content": "PM", "fill": "$color.brand", "fontSize": 13, "fontWeight": "600" }] }, { "id": "source-ka", "type": "text", "x": 106, "y": 13, "content": "KA", "fill": "$color.secondary", "fontSize": 13, "fontWeight": "600" }] },
                    { "id": "chart-grid-1", "type": "rectangle", "x": 16, "y": 242, "width": 740, "height": 1, "fill": "$color.border" },
                    { "id": "chart-grid-2", "type": "rectangle", "x": 16, "y": 286, "width": 740, "height": 1, "fill": "$color.border" },
                    { "id": "chart-grid-3", "type": "rectangle", "x": 16, "y": 330, "width": 740, "height": 1, "fill": "$color.border" },
                    { "id": "price-chart", "type": "path", "x": 16, "y": 210, "width": 740, "height": 150, "geometry": "M 0 125 L 45 112 L 90 116 L 135 96 L 180 105 L 225 78 L 270 83 L 315 62 L 360 70 L 405 48 L 450 54 L 495 35 L 540 42 L 585 24 L 630 31 L 680 10 L 740 18", "viewBox": [0, 0, 740, 150], "stroke": "$color.success", "strokeWidth": 3, "fill": "#00000000" },
                    { "id": "outcomes-top-border", "type": "rectangle", "x": 16, "y": 378, "width": 740, "height": 1, "fill": "$color.border" },
                    { "id": "outcome-up", "type": "text", "x": 16, "y": 392, "content": "Up", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
                    { "id": "outcome-up-value", "type": "text", "x": 718, "y": 392, "content": "61%", "fill": "$color.text", "fontSize": 14, "fontWeight": "500", "textAlign": "right" },
                    { "id": "outcome-divider", "type": "rectangle", "x": 16, "y": 420, "width": 740, "height": 1, "fill": "$color.border" },
                    { "id": "outcome-down", "type": "text", "x": 16, "y": 434, "content": "Down", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
                    { "id": "outcome-down-value", "type": "text", "x": 718, "y": 434, "content": "39%", "fill": "$color.text", "fontSize": 14, "fontWeight": "500", "textAlign": "right" }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "desktop-caption", "type": "text", "x": 24, "y": 20, "content": "FeaturedMarkets / desktop / ready chart", "fill": "$color.secondary", "fontSize": 14, "fontWeight": "600" }
      ]
    },
    {
      "id": "mobile-specimen",
      "name": "Mobile — BTC crypto cards",
      "type": "frame",
      "x": 1240,
      "y": 0,
      "width": 390,
      "height": 800,
      "fill": "$color.background",
      "cornerRadius": "$radius.medium",
      "clip": true,
      "children": [
        { "id": "mobile-caption", "type": "text", "x": 16, "y": 16, "content": "FeaturedMarkets / mobile / crypto", "fill": "$color.secondary", "fontSize": 13, "fontWeight": "600" },
        { "id": "mobile-tabs", "type": "frame", "x": 16, "y": 48, "width": 358, "height": 40, "fill": "#121A2A", "cornerRadius": 12, "children": [{ "id": "mobile-tab-crypto", "type": "frame", "x": 4, "y": 4, "width": 171, "height": 32, "fill": "$color.brandSoft", "cornerRadius": 8, "children": [{ "id": "mobile-tab-crypto-text", "type": "text", "x": 14, "y": 9, "content": "Crypto Up or Down", "fill": "$color.brand", "fontSize": 13, "fontWeight": "600" }] }, { "id": "mobile-tab-trending", "type": "text", "x": 220, "y": 13, "content": "Trending", "fill": "$color.secondary", "fontSize": 13, "fontWeight": "600" }] },
        { "id": "mobile-crypto-panel", "type": "frame", "x": 16, "y": 104, "width": 358, "height": 592, "fill": "$color.layer", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.medium", "children": [
          { "id": "mobile-assets", "type": "frame", "x": 0, "y": 8, "width": 358, "height": 42, "fill": "$color.layer", "stroke": "$color.border", "strokeWidth": { "bottom": 1 }, "children": [{ "id": "mobile-btc", "type": "text", "x": 14, "y": 12, "content": "BTC  61% Up", "fill": "$color.success", "fontSize": 13, "fontWeight": "600" }, { "id": "mobile-eth", "type": "text", "x": 136, "y": 12, "content": "ETH  54% Down", "fill": "$color.secondary", "fontSize": 13, "fontWeight": "600" }, { "id": "mobile-sol", "type": "text", "x": 272, "y": 12, "content": "SOL", "fill": "$color.secondary", "fontSize": 13, "fontWeight": "600" }] },
          { "id": "mobile-card", "type": "frame", "x": 8, "y": 66, "width": 342, "height": 510, "fill": "$color.layer", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": "$radius.medium", "children": [
            { "id": "mobile-btc-avatar", "type": "frame", "x": 16, "y": 16, "width": 48, "height": 48, "fill": "#1E293B", "cornerRadius": 8, "children": [{ "id": "mobile-btc-avatar-text", "type": "text", "x": 9, "y": 15, "content": "BTC", "fill": "$color.text", "fontSize": 13, "fontWeight": "700" }] },
            { "id": "mobile-title", "type": "text", "x": 76, "y": 16, "width": 210, "textGrowth": "fixed-width", "content": "BTC 15 Minute Up or Down", "fill": "$color.text", "fontSize": 17, "fontWeight": "500" },
            { "id": "mobile-status", "type": "text", "x": 76, "y": 39, "content": "Ends in 08:42", "fill": "$color.secondary", "fontSize": 13 },
            { "id": "mobile-period", "type": "text", "x": 76, "y": 58, "content": "12:00–12:15 UTC", "fill": "$color.muted", "fontSize": 12 },
            { "id": "mobile-stat-1", "type": "text", "x": 16, "y": 100, "content": "$104,200", "fill": "$color.text", "fontSize": 15, "fontWeight": "500" },
            { "id": "mobile-stat-1-label", "type": "text", "x": 16, "y": 122, "content": "Price to Beat", "fill": "$color.secondary", "fontSize": 11 },
            { "id": "mobile-stat-2", "type": "text", "x": 138, "y": 100, "content": "$104,840", "fill": "$color.success", "fontSize": 15, "fontWeight": "500" },
            { "id": "mobile-stat-2-label", "type": "text", "x": 138, "y": 122, "content": "Current Price", "fill": "$color.secondary", "fontSize": 11 },
            { "id": "mobile-stat-3", "type": "text", "x": 260, "y": 100, "content": "$1.2M", "fill": "$color.text", "fontSize": 15, "fontWeight": "500" },
            { "id": "mobile-stat-3-label", "type": "text", "x": 260, "y": 122, "content": "Volume", "fill": "$color.secondary", "fontSize": 11 },
            { "id": "mobile-source-tabs", "type": "frame", "x": 16, "y": 158, "width": 150, "height": 38, "fill": "#0B1120", "cornerRadius": 12, "children": [{ "id": "mobile-source-pm", "type": "frame", "x": 4, "y": 4, "width": 66, "height": 30, "fill": "$color.brandSoft", "cornerRadius": 8, "children": [{ "id": "mobile-source-pm-text", "type": "text", "x": 21, "y": 8, "content": "PM", "fill": "$color.brand", "fontSize": 12, "fontWeight": "600" }] }, { "id": "mobile-source-ka", "type": "text", "x": 102, "y": 12, "content": "KA", "fill": "$color.secondary", "fontSize": 12, "fontWeight": "600" }] },
            { "id": "mobile-row-top", "type": "rectangle", "x": 16, "y": 220, "width": 310, "height": 1, "fill": "$color.border" },
            { "id": "mobile-up", "type": "text", "x": 16, "y": 235, "content": "Up", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
            { "id": "mobile-up-value", "type": "text", "x": 280, "y": 235, "width": 30, "textGrowth": "fixed-width", "textAlign": "right", "content": "61%", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
            { "id": "mobile-row-middle", "type": "rectangle", "x": 16, "y": 264, "width": 310, "height": 1, "fill": "$color.border" },
            { "id": "mobile-down", "type": "text", "x": 16, "y": 279, "content": "Down", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
            { "id": "mobile-down-value", "type": "text", "x": 280, "y": 279, "width": 30, "textGrowth": "fixed-width", "textAlign": "right", "content": "39%", "fill": "$color.text", "fontSize": 14, "fontWeight": "500" },
            { "id": "mobile-insight-rule", "type": "rectangle", "x": 16, "y": 330, "width": 2, "height": 48, "fill": "$color.brand" },
            { "id": "mobile-insight", "type": "text", "x": 28, "y": 330, "width": 280, "textGrowth": "fixed-width", "content": "Insight: Supplied market context stays separate from the reusable component.", "fill": "$color.secondary", "fontSize": 12, "lineHeight": 1.4 },
            { "id": "mobile-view-event", "type": "frame", "x": 16, "y": 420, "width": 310, "height": 40, "fill": "$color.layer", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": 8, "children": [{ "id": "mobile-view-event-text", "type": "text", "x": 120, "y": 11, "content": "View Event", "fill": "$color.text", "fontSize": 14, "fontWeight": "600" }] }
          ] }
        ] },
        { "id": "browse-all", "type": "frame", "x": 115, "y": 720, "width": 160, "height": 40, "fill": "$color.layer", "stroke": "$color.border", "strokeWidth": 1, "cornerRadius": 8, "children": [{ "id": "browse-all-text", "type": "text", "x": 47, "y": 11, "content": "Browse All", "fill": "$color.text", "fontSize": 14, "fontWeight": "600" }] }
      ]
    }
  ]
}
