{
  "compilerOptions": {
    "paths": {
      "@grade10/ui/*": ["./src/*"]
    },
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    /* An image import resolves to a URL the consumer's bundler emits, and
       `vite/client` is where that is declared — every consumer of this
       package builds with it. */
    "types": ["react", "react-dom", "vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.figma.ts"]
}
