{
  "name": "@grade10/design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens:pull": "node scripts/figma/pull.mjs",
    "tokens:build": "node scripts/build-css.mjs",
    "tokens:push": "node scripts/figma/push.mjs",
    "tokens:plugin": "node scripts/figma/build-plugin.mjs",
    "tokens:sync": "pnpm tokens:pull && pnpm tokens:build",
    "components:check": "node scripts/check-components.mjs",
    "code-connect:publish": "figma connect publish --exit-on-unreadable-files",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "storybook": "storybook dev",
    "build-storybook": "storybook build",
    "test:stories": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./themes/*": "./src/themes/*",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "^1.62.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.15.0",
    "storybook": "10.5.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
