{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    // A test runs under vitest, which is Node, and reads the store's own team
    // map off the disk; it also drives modules written for the Worker, so it
    // holds both sets of types. `@types/node` is the workspace's own, at the
    // version the manual reads.
    "types": ["node", "@cloudflare/workers-types"],
    "skipLibCheck": true,
    "allowJs": false,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test"]
}
