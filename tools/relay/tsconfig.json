{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    // The Worker runtime, not Node: the relay uses WebCrypto, fetch and the
    // Durable Object API, and nothing from `node:*`. The tests run the same
    // modules under vitest, which gives them the same globals.
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test"]
}
