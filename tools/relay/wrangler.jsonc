{
  // The relay at https://grade10-relay.<subdomain>.workers.dev on the staging
  // Cloudflare account, the same account the manual is deployed to. No
  // `$schema` line: wrangler is not a dependency here, it is run through
  // `pnpm dlx` by the `deploy` script, so there is no local schema file to
  // point at.
  "name": "grade10-relay",
  "compatibility_date": "2026-08-01",
  "account_id": "de021143aac704ccbda9c3cd00be261d",
  "main": "src/worker.ts",
  // One room per Slack thread, and one per change as the address a landing
  // wake is sent to. The room holds the queue, so two wakes on one thread are
  // one at a time however many edges they arrive on.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The Slack app's request URL and the workflow's wake URL are the
  // workers.dev address; no custom domain is needed for either.
  "workers_dev": true,
  // Placeholders. Set the real values here before the first deploy:
  // PLANNING_CHANNEL is the Slack channel id the planning threads live in,
  // REPO is the store as `owner/name`, and RELAY_URL is this Worker's own
  // origin, which the payload hands the run to post back to.
  "vars": {
    "PLANNING_CHANNEL": "C00000000",
    "REPO": "owner/name",
    "RELAY_URL": "https://grade10-relay.workers.dev"
  }
  // Secrets, each set with `pnpm dlx wrangler@4.120.0 secret put <name>`:
  // SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, ROUTINE_FIRE_URL, ROUTINE_TOKEN,
  // GITHUB_TOKEN, TOKEN_SECRET, WAKE_TOKEN. No value of any of them belongs in
  // this file or in any other file here.
}
