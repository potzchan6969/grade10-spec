{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.src.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    // The Worker runtime, not Node: the relay uses WebCrypto, fetch and the
    // Durable Object API. Node's types are the test project's alone, so an
    // import of `node:*` in `src` does not compile here - which is the whole
    // reason the two projects are split.
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    // The store's own pure modules — `handle.mjs`, `team-parse.mjs` — are
    // plain JavaScript with a `.d.mts` beside them, as the manual's browser
    // project reads them.
    "allowJs": false,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
